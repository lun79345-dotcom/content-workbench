# Optional configuration. Local development works without copying this file.
# Never commit .env.local or your production database.
# Demo login defaults to local development only. Keep 0 for external deployment.
DEV_LOGIN=0
# Generate your own random value before using production mode.
SESSION_SECRET=
COOKIE_SECURE=0
APP_URL=http://127.0.0.1:3000
BASE_PATH=
# Stop reminders while inspecting the sample data.
DISABLE_JOBS=1
# Optional enterprise Feishu app; leave blank for local demo.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Verified open_ids in YOUR app/tenant, comma separated; never display names.
BOSS_FEISHU_OPEN_IDS=
# Optional interaction metrics. View counts remain manually entered.
TIKHUB_API_KEY=
# Default data path: ./data
# DATA_DIR=/absolute/path/to/your/own/database-directory
