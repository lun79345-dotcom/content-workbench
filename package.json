{
  "name": "content-workbench",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run build:review-worker && next build",
    "build:review-worker": "node scripts/build-account-review-worker.mjs",
    "review:worker": "node scripts/account-review-worker.mjs",
